# Public application URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Meta / Instagram API with Instagram Login
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# 32-byte key encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared by GitHub Actions and the application.
CRON_SECRET=

# Optional bootstrap administrator. Sign-up must remain disabled in Supabase.
BOOTSTRAP_ADMIN_EMAIL=
