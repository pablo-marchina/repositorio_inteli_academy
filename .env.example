# Public application URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI (Google Gemini API)
GEMINI_API_KEY=
# Best free model currently used for post generation and reviews.
GEMINI_POST_MODEL=gemini-3.6-flash
# High-throughput free model used only to classify collected articles.
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite

# Collection inspired by the previous n8n collector.
# Every valid feed found in the catalog is fetched; there is no feed-count cap.
COMMUNITY_FEED_DISCOVERY=true
COMMUNITY_FEED_CATALOG_URL=https://raw.githubusercontent.com/foorilla/allainews_sources/refs/heads/main/README.md
# After all feeds are fetched and deduplicated, only the strongest recent candidates are classified.
MAX_ARTICLES_TO_CLASSIFY=60
MIN_ARTICLE_RELEVANCE=5.5

# Meta / Instagram API with Instagram Login
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0

# 32-byte key encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared by GitHub Actions and the application.
CRON_SECRET=

# Optional bootstrap administrator. Sign-up must remain disabled in Supabase.
BOOTSTRAP_ADMIN_EMAIL=
