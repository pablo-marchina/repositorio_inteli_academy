# Public application URL, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# AI (Google Gemini API)
GEMINI_API_KEY=
# Best free model currently used for post generation and reviews.
GEMINI_POST_MODEL=gemini-3.6-flash
# High-throughput free model used only to classify collected articles.
GEMINI_FILTER_MODEL=gemini-3.5-flash-lite

# Collection inspired by the previous n8n collector.
# Every valid feed found in the catalog is fetched; there is no feed-count cap.
COMMUNITY_FEED_DISCOVERY=true
COMMUNITY_FEED_CATALOG_URL=https://raw.githubusercontent.com/foorilla/allainews_sources/refs/heads/main/README.md
# After all feeds are fetched and deduplicated, only the strongest recent candidates are classified.
MAX_ARTICLES_TO_CLASSIFY=60
MIN_ARTICLE_RELEVANCE=5.5

# Instagram API with Instagram Login.
# IMPORTANT: copy the Instagram App ID and Instagram App Secret shown inside the
# Instagram product setup in Meta App Dashboard. Do not confuse them with other
# Meta/Facebook app credentials. Register this exact OAuth callback there:
# <NEXT_PUBLIC_APP_URL>/api/instagram/callback
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: paste the exact Business Login embed URL generated by Meta. The app
# will still inject the current callback, scopes and CSRF state before redirecting.
# INSTAGRAM_BUSINESS_LOGIN_URL=
META_GRAPH_VERSION=v26.0

# Legacy aliases kept only for existing deployments. New setups should leave these
# empty and use INSTAGRAM_APP_ID / INSTAGRAM_APP_SECRET above.
# META_APP_ID=
# META_APP_SECRET=

# Google Drive media library. Create a Google OAuth Web client and register this
# exact URI in Authorized redirect URIs:
# <NEXT_PUBLIC_APP_URL>/api/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_ROOT_FOLDER_ID=1UNwO3RgmjCshbVUoxsoFSLmxFFlOrkhH

# Figma ID Academy. FIGMA_ACCESS_TOKEN is server-only and is used to read/export
# the final reviewed frames. The local Content Bridge now pairs through a temporary
# code shown to authenticated admins in Settings; users never need the server secret.
FIGMA_ACCESS_TOKEN=
FIGMA_FILE_KEY=xFV6r1G9gMjWvLf7gqyuYo
FIGMA_OUTPUT_PAGE_NAME=Academy • Gerações
# Optional legacy signing secret. If omitted, CRON_SECRET signs bridge pairings.
FIGMA_PLUGIN_SECRET=

# 32-byte key encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Shared by GitHub Actions and the application. It also signs Figma pairing tokens
# when FIGMA_PLUGIN_SECRET is not configured.
CRON_SECRET=

# Optional bootstrap administrator. Sign-up must remain disabled in Supabase.
BOOTSTRAP_ADMIN_EMAIL=
