+import { apiAdmin } from "@/lib/api-auth";
+import { downloadDriveAsset } from "@/lib/google-drive";
+import { getCurrentFigmaRenderUrls, getCurrentFigmaSemanticState } from "@/lib/figma";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { createTarGz, packageAssetPath } from "@/lib/studio-after-effects-export";
+import { davinciBridgeScript, davinciReadme, serializeDavinciFcpxml, type DavinciFigmaLayer } from "@/lib/studio-davinci-export";
+import { serializeEditorManifest, serializeOtio } from "@/lib/studio-editor-export";
+import { publicDriveMediaUrl } from "@/lib/studio";
+import type { StructuredStudioPayload, StudioVideoTimeline } from "@/lib/studio-artifact";
+import type { DriveAsset } from "@/lib/types";
+
+export const runtime = "nodejs";
+export const maxDuration = 300;
+const MAX_BUNDLED_ASSET_BYTES = 25 * 1024 * 1024;
+
+function slug(value: string) {
+  return value.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 64) || "academy-video";
+}
+
+function safe(value: string) {
+  return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-zA-Z0-9._-]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 90) || "layer";
+}
+
+function roleWindow(timeline: StudioVideoTimeline, role: string) {
+  const track = timeline.tracks.find((candidate) => candidate.role === role);
+  return track
+    ? { startFrame: track.startFrame, durationInFrames: track.durationInFrames, zIndex: track.zIndex }
+    : { startFrame: 0, durationInFrames: timeline.durationInFrames, zIndex: 10 };
+}
+
+async function fetchBytes(url: string) {
+  const response = await fetch(url, { cache: "no-store" });
+  if (!response.ok) throw new Error(`Falha ao baixar layer do Figma (${response.status}).`);
+  return new Uint8Array(await response.arrayBuffer());
+}
+
+export async function GET(_: Request, context: { params: Promise<{ projectId: string; versionId: string }> }) {
+  const auth = await apiAdmin();
+  if (!auth) return Response.json({ error: "Não autorizado." }, { status: 401 });
+  try {
+    const { projectId, versionId } = await context.params;
+    const admin = createAdminClient();
+    const [{ data: project, error: projectError }, { data: version, error: versionError }] = await Promise.all([
+      admin.from("content_projects").select("id,name,content_type,drive_assets,figma_file_key").eq("id", projectId).single(),
+      admin.from("content_versions").select("id,version_number,payload,figma_frame_ids").eq("id", versionId).eq("project_id", projectId).single()
+    ]);
+    if (projectError) throw projectError;
+    if (versionError) throw versionError;
+    if (project.content_type !== "reel") throw new Error("Exportação para DaVinci Resolve está disponível para Reel/vídeo.");
+
+    const payload = version.payload as StructuredStudioPayload;
+    const timeline = payload.artifact?.videoTimeline;
+    if (!timeline) throw new Error("Esta versão ainda não possui timeline estruturada de vídeo.");
+    const frameIds = Array.isArray(version.figma_frame_ids) ? version.figma_frame_ids.map(String) : [];
+    if (!frameIds.length) throw new Error("Sincronize a versão com o Figma antes de exportar para o DaVinci, para incluir logo, mascote e grafismos reais como layers separados.");
+
+    const [semantic] = await getCurrentFigmaSemanticState([frameIds[0]]);
+    const graphicRoles = ["primaryLogo", "partnerLogo", "mascot", "brandElement", "decoration", "eyebrow", "headline", "body"];
+    const selectedNodes: Array<{ role: string; id: string; name: string; text?: string; box?: { x: number; y: number; width: number; height: number } }> = [];
+    const usedNodeIds = new Set<string>();
+    for (const role of graphicRoles) {
+      const values = semantic.roles[role] ?? (role === "primaryLogo" ? semantic.roles.logo ?? [] : []);
+      for (const item of values) {
+        if (!item.id || usedNodeIds.has(item.id)) continue;
+        usedNodeIds.add(item.id);
+        selectedNodes.push({ role, id: item.id, name: item.name || role, text: item.text, box: item.box });
+      }
+    }
+
+    const figmaUrls = selectedNodes.length ? await getCurrentFigmaRenderUrls(selectedNodes.map((item) => item.id), "png") : [];
+    const figmaLayers: DavinciFigmaLayer[] = [];
+    const figmaFiles: Array<{ path: string; data: Uint8Array }> = [];
+    for (let index = 0; index < selectedNodes.length; index += 1) {
+      const node = selectedNodes[index];
+      const window = roleWindow(timeline, node.role);
+      const relativePath = `figma/${safe(`${node.role}-${index + 1}-${node.name}`)}.png`;
+      figmaLayers.push({ ...node, relativePath, ...window });
+      figmaFiles.push({ path: relativePath, data: await fetchBytes(figmaUrls[index]) });
+    }
+
+    const driveAssets = Array.isArray(project.drive_assets) ? (project.drive_assets as DriveAsset[]) : [];
+    const usedAssetIds = [...new Set(timeline.tracks.flatMap((track) => track.assetId ? [track.assetId] : []))];
+    const assetFiles = usedAssetIds.flatMap((assetId) => {
+      const asset = driveAssets.find((candidate) => candidate.id === assetId);
+      return asset ? [{ asset, relativePath: packageAssetPath(asset) }] : [];
+    });
+    const bundled: Array<{ path: string; data: Uint8Array }> = [];
+    const externalAssets: Array<{ id: string; name: string; relativePath: string; sourceUrl: string }> = [];
+    for (const file of assetFiles) {
+      const declaredSize = Number(file.asset.size ?? 0);
+      if (declaredSize > 0 && declaredSize <= MAX_BUNDLED_ASSET_BYTES) {
+        const downloaded = await downloadDriveAsset(file.asset.id);
+        bundled.push({ path: file.relativePath, data: downloaded.bytes });
+      } else {
+        externalAssets.push({ id: file.asset.id, name: file.asset.name, relativePath: file.relativePath, sourceUrl: publicDriveMediaUrl(projectId, file.asset.id) });
+      }
+    }
+
+    const assetPath = (asset: DriveAsset) => assetFiles.find((file) => file.asset.id === asset.id)?.relativePath ?? packageAssetPath(asset);
+    const fcpxml = serializeDavinciFcpxml({ payload, projectName: String(project.name), driveAssets, assetPath, figmaLayers });
+    const otio = serializeOtio({ payload, projectName: String(project.name), assetUrl: (assetId) => publicDriveMediaUrl(projectId, assetId) });
+    const editorManifest = serializeEditorManifest({
+      payload,
+      projectId,
+      projectName: String(project.name),
+      versionNumber: Number(version.version_number),
+      driveAssets,
+      figmaFileKey: project.figma_file_key ? String(project.figma_file_key) : null,
+      assetUrl: (assetId) => publicDriveMediaUrl(projectId, assetId)
+    });
+    const manifest = {
+      schema: "inteli-academy-davinci-package/v1",
+      projectId,
+      projectName: String(project.name),
+      versionNumber: Number(version.version_number),
+      timeline,
+      musicSelectionReason: payload.artifact?.reelPlan?.musicSelectionReason ?? null,
+      figma: { fileKey: project.figma_file_key ?? null, frameId: frameIds[0], layers: figmaLayers },
+      assets: assetFiles.map((file) => ({ id: file.asset.id, name: file.asset.name, mimeType: file.asset.mimeType, relativePath: file.relativePath, bundled: !externalAssets.some((external) => external.id === file.asset.id) })),
+      externalAssets
+    };
+
+    const files = [
+      { path: "AcademyTimeline.fcpxml", data: fcpxml },
+      { path: "AcademyTimeline.otio", data: JSON.stringify(otio, null, 2) },
+      { path: "AcademyEditorManifest.json", data: JSON.stringify(editorManifest, null, 2) },
+      { path: "project-manifest.json", data: JSON.stringify(manifest, null, 2) },
+      { path: "AcademyResolveImport.py", data: davinciBridgeScript(String(project.name), Number(version.version_number)) },
+      { path: "README.txt", data: davinciReadme(Number(version.version_number)) },
+      ...figmaFiles,
+      ...bundled
+    ];
+    const archive = createTarGz(files);
+    const fileBase = `${slug(String(project.name))}-v${version.version_number}`;
+    return new Response(new Uint8Array(archive), {
+      headers: {
+        "content-type": "application/gzip",
+        "content-disposition": `attachment; filename="${fileBase}-davinci-resolve.tar.gz"`,
+        "cache-control": "private, no-store"
+      }
+    });
+  } catch (error) {
+    return Response.json({ error: String(error) }, { status: 400 });
+  }
+}
